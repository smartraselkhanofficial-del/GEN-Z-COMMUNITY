{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information in GEN Z COMMUNITY",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Auth UID of the user" },
        "username": { "type": "string", "description": "Unique handle without @" },
        "displayName": { "type": "string", "description": "Full display name" },
        "email": { "type": "string", "description": "User email address" },
        "avatarUrl": { "type": "string", "description": "URL or avatar identifier" },
        "bio": { "type": "string", "description": "Bio or status message" },
        "role": { "type": "string", "description": "Role: user or admin" },
        "isOnline": { "type": "boolean", "description": "Current presence status" },
        "friendsCount": { "type": "number", "description": "Count of connected friends" },
        "followersCount": { "type": "number", "description": "Follower count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update timestamp via serverTimestamp" }
      },
      "required": ["userId", "username", "displayName", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Social feed post",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "User UID of author" },
        "authorName": { "type": "string", "description": "Display name of author" },
        "authorAvatar": { "type": "string", "description": "Avatar of author" },
        "content": { "type": "string", "description": "Text content of post" },
        "mediaUrl": { "type": "string", "description": "Optional media attachment URL" },
        "mediaType": { "type": "string", "description": "image or video" },
        "tag": { "type": "string", "description": "Topic or hashtag" },
        "likesCount": { "type": "number", "description": "Number of likes" },
        "commentsCount": { "type": "number", "description": "Number of comments" },
        "likedUserIds": { "type": "array", "description": "List of user UIDs who liked" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["authorId", "authorName", "content", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a post",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "ID of parent post" },
        "authorId": { "type": "string", "description": "User UID of commenter" },
        "authorName": { "type": "string", "description": "Display name of commenter" },
        "authorAvatar": { "type": "string", "description": "Avatar URL of commenter" },
        "text": { "type": "string", "description": "Comment text" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["postId", "authorId", "authorName", "text", "createdAt"]
    },
    "Moment": {
      "title": "Moment",
      "description": "24-hour social moment / story",
      "type": "object",
      "properties": {
        "authorId": { "type": "string", "description": "User UID of creator" },
        "authorName": { "type": "string", "description": "Creator display name" },
        "authorAvatar": { "type": "string", "description": "Creator avatar" },
        "caption": { "type": "string", "description": "Story caption" },
        "mediaUrl": { "type": "string", "description": "Image/video URL" },
        "bgGradient": { "type": "string", "description": "Gradient style descriptor" },
        "viewsCount": { "type": "number", "description": "Story views" },
        "reactionsCount": { "type": "number", "description": "Total reactions" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["authorId", "authorName", "createdAt"]
    },
    "LiveRoom": {
      "title": "LiveRoom",
      "description": "Kuki-style live audio stage room",
      "type": "object",
      "properties": {
        "hostId": { "type": "string", "description": "Host user UID" },
        "hostName": { "type": "string", "description": "Host display name" },
        "title": { "type": "string", "description": "Room title" },
        "description": { "type": "string", "description": "Room description or topic" },
        "category": { "type": "string", "description": "Category: Music, Gaming, Tech, Chill, Debate" },
        "isActive": { "type": "boolean", "description": "Whether room is currently live" },
        "participantCount": { "type": "number", "description": "Total participants" },
        "speakers": { "type": "array", "description": "List of user UIDs speaking" },
        "listeners": { "type": "array", "description": "List of user UIDs listening" },
        "handRaisedUserIds": { "type": "array", "description": "List of user UIDs requesting to speak" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["hostId", "hostName", "title", "category", "isActive", "createdAt"]
    },
    "RoomChat": {
      "title": "RoomChat",
      "description": "Live text message in audio room",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "ID of parent room" },
        "senderId": { "type": "string", "description": "Sender UID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "text": { "type": "string", "description": "Message content" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["roomId", "senderId", "senderName", "text", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "One-on-one or group conversation metadata",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array", "description": "List of participant UIDs" },
        "isGroup": { "type": "boolean", "description": "True if group conversation" },
        "groupName": { "type": "string", "description": "Group title" },
        "lastMessage": { "type": "string", "description": "Latest message excerpt" },
        "lastSenderId": { "type": "string", "description": "UID of last sender" },
        "lastMessageTime": { "type": "string", "format": "date-time", "description": "Timestamp of last message" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["participantIds", "isGroup", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a chat",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "description": "Parent chat ID" },
        "senderId": { "type": "string", "description": "Sender UID" },
        "senderName": { "type": "string", "description": "Sender display name" },
        "text": { "type": "string", "description": "Text content" },
        "mediaUrl": { "type": "string", "description": "Optional image/audio attachment URL" },
        "mediaType": { "type": "string", "description": "text, image, or audio" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["chatId", "senderId", "senderName", "text", "createdAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "WebRTC real-time 1-on-1 calling session",
      "type": "object",
      "properties": {
        "callerId": { "type": "string", "description": "Initiator UID" },
        "callerName": { "type": "string", "description": "Initiator display name" },
        "receiverId": { "type": "string", "description": "Target UID" },
        "receiverName": { "type": "string", "description": "Target display name" },
        "callType": { "type": "string", "description": "audio or video" },
        "status": { "type": "string", "description": "ringing, accepted, rejected, ended" },
        "sdpOffer": { "type": "string", "description": "SDP offer payload" },
        "sdpAnswer": { "type": "string", "description": "SDP answer payload" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Call initiation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Call update timestamp" }
      },
      "required": ["callerId", "callerName", "receiverId", "callType", "status", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Social connection invitation between users",
      "type": "object",
      "properties": {
        "senderId": { "type": "string", "description": "Requester UID" },
        "senderName": { "type": "string", "description": "Requester display name" },
        "receiverId": { "type": "string", "description": "Recipient UID" },
        "receiverName": { "type": "string", "description": "Recipient display name" },
        "status": { "type": "string", "description": "pending, accepted, rejected" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Request creation timestamp" }
      },
      "required": ["senderId", "senderName", "receiverId", "status", "createdAt"]
    },
    "Community": {
      "title": "Community",
      "description": "Themed Gen Z interest hub",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string", "description": "Creator user UID" },
        "name": { "type": "string", "description": "Community name" },
        "description": { "type": "string", "description": "Community topic and description" },
        "category": { "type": "string", "description": "Interest category" },
        "membersCount": { "type": "number", "description": "Total member count" },
        "memberIds": { "type": "array", "description": "List of member UIDs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["creatorId", "name", "category", "membersCount", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Moderation report filed by a user",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "description": "User filing report" },
        "targetId": { "type": "string", "description": "ID of reported content or user" },
        "targetType": { "type": "string", "description": "post, user, room, community" },
        "reason": { "type": "string", "description": "Reason for violation" },
        "status": { "type": "string", "description": "pending or resolved" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Report timestamp" }
      },
      "required": ["reporterId", "targetId", "targetType", "reason", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile store"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Social feed posts"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Post comments"
    },
    "/moments/{momentId}": {
      "schema": { "$ref": "#/entities/Moment" },
      "description": "24h social moments"
    },
    "/liveRooms/{roomId}": {
      "schema": { "$ref": "#/entities/LiveRoom" },
      "description": "Live audio rooms"
    },
    "/liveRooms/{roomId}/roomChats/{chatId}": {
      "schema": { "$ref": "#/entities/RoomChat" },
      "description": "Live room real-time text chats"
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "1-on-1 and group chats"
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a chat"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallSession" },
      "description": "Audio and video call signaling sessions"
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend request invitations"
    },
    "/communities/{communityId}": {
      "schema": { "$ref": "#/entities/Community" },
      "description": "Community interest hubs"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Content and user moderation reports"
    }
  }
}
